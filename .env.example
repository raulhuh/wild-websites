# Wild Websites — Umgebungsvariablen
#
# Kopiere diese Datei zu ".env" (nicht ".env.example") und trag deine echten
# Werte ein. ".env" ist in .gitignore und wird NIE committed.
#
#   cp .env.example .env
#
# Danach: ./scripts/setup-check.sh ausführen, um zu prüfen ob alles passt.

# OpenAI — für Bildgenerierung (falls im Prompt-Setup genutzt).
# Key holen: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Higgsfield — für Bild-/Videogenerierung (hf_image / hf_video in scripts/higgsfield.sh).
# Account + API-Key holen: https://higgsfield.ai (Cloud/API-Bereich).
# Format: zwei getrennte Werte, ID und Secret.
HIGSFIELD_API_ID=
HIGSFIELD_API_SECRET=
